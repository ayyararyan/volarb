{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "media_type": {
          "default": "application/json",
          "title": "Media Type",
          "type": "string"
        },
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Size Bytes"
        },
        "uri": {
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "uri",
        "sha256"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "ControlledGeneratorReview": {
      "additionalProperties": false,
      "properties": {
        "effect": {
          "title": "Effect",
          "type": "number"
        },
        "n_sessions": {
          "maximum": 10000,
          "minimum": 5,
          "title": "N Sessions",
          "type": "integer"
        },
        "noise_distribution": {
          "const": "IID Gaussian mean zero",
          "default": "IID Gaussian mean zero",
          "title": "Noise Distribution",
          "type": "string"
        },
        "noise_standard_deviation": {
          "minimum": 0,
          "title": "Noise Standard Deviation",
          "type": "number"
        },
        "rng": {
          "const": "numpy.random.default_rng",
          "default": "numpy.random.default_rng",
          "title": "Rng",
          "type": "string"
        },
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "seed": {
          "title": "Seed",
          "type": "integer"
        },
        "session_labels": {
          "const": "business days from 2020-01-01; not historical dates",
          "default": "business days from 2020-01-01; not historical dates",
          "title": "Session Labels",
          "type": "string"
        }
      },
      "required": [
        "n_sessions",
        "effect",
        "noise_standard_deviation",
        "seed"
      ],
      "title": "ControlledGeneratorReview",
      "type": "object"
    },
    "ExperimentSpec": {
      "additionalProperties": false,
      "properties": {
        "approval_scope_id": {
          "default": "campaign",
          "title": "Approval Scope Id",
          "type": "string"
        },
        "baseline_id": {
          "default": "B0-simple",
          "title": "Baseline Id",
          "type": "string"
        },
        "baseline_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "campaign_id": {
          "title": "Campaign Id",
          "type": "string"
        },
        "dataset_id": {
          "title": "Dataset Id",
          "type": "string"
        },
        "dataset_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "dsl": {
          "additionalProperties": true,
          "title": "Dsl",
          "type": "object"
        },
        "environment_hash": {
          "default": "unbound",
          "title": "Environment Hash",
          "type": "string"
        },
        "evaluator": {
          "enum": [
            "exp001",
            "iron_butterfly",
            "controlled"
          ],
          "title": "Evaluator",
          "type": "string"
        },
        "evaluator_version": {
          "const": "1",
          "default": "1",
          "title": "Evaluator Version",
          "type": "string"
        },
        "fidelity": {
          "$ref": "#/$defs/Fidelity",
          "default": "F0"
        },
        "graph_version": {
          "const": "1",
          "default": "1",
          "title": "Graph Version",
          "type": "string"
        },
        "hypothesis_id": {
          "title": "Hypothesis Id",
          "type": "string"
        },
        "hypothesis_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "implementation_hash": {
          "default": "builtin-v1",
          "title": "Implementation Hash",
          "type": "string"
        },
        "inference": {
          "$ref": "#/$defs/InferencePlan"
        },
        "informed_by_result_ids": {
          "items": {
            "type": "string"
          },
          "title": "Informed By Result Ids",
          "type": "array"
        },
        "max_repairs": {
          "default": 2,
          "maximum": 2,
          "minimum": 0,
          "title": "Max Repairs",
          "type": "integer"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        },
        "parent_experiment_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Experiment Id"
        },
        "relation": {
          "$ref": "#/$defs/Relation",
          "default": "NEW"
        },
        "rerun_ordinal": {
          "default": 0,
          "minimum": 0,
          "title": "Rerun Ordinal",
          "type": "integer"
        },
        "resources": {
          "$ref": "#/$defs/RunResources"
        },
        "robustness": {
          "items": {
            "type": "string"
          },
          "title": "Robustness",
          "type": "array"
        },
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "seed": {
          "default": 17,
          "title": "Seed",
          "type": "integer"
        },
        "split": {
          "$ref": "#/$defs/SplitPlan"
        },
        "trial_id": {
          "title": "Trial Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "campaign_id",
        "hypothesis_id",
        "trial_id",
        "dataset_id",
        "evaluator"
      ],
      "title": "ExperimentSpec",
      "type": "object"
    },
    "Fidelity": {
      "enum": [
        "F0",
        "F1",
        "F2",
        "F3",
        "F4"
      ],
      "title": "Fidelity",
      "type": "string"
    },
    "HypothesisSpec": {
      "additionalProperties": false,
      "properties": {
        "alternative_explanations": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Alternative Explanations",
          "type": "array"
        },
        "baseline_id": {
          "title": "Baseline Id",
          "type": "string"
        },
        "campaign_id": {
          "title": "Campaign Id",
          "type": "string"
        },
        "decision_change": {
          "minLength": 8,
          "title": "Decision Change",
          "type": "string"
        },
        "evaluator": {
          "default": "iron_butterfly",
          "enum": [
            "exp001",
            "iron_butterfly",
            "controlled"
          ],
          "title": "Evaluator",
          "type": "string"
        },
        "expected_direction": {
          "minLength": 1,
          "title": "Expected Direction",
          "type": "string"
        },
        "falsification_rule": {
          "minLength": 12,
          "title": "Falsification Rule",
          "type": "string"
        },
        "family_id": {
          "title": "Family Id",
          "type": "string"
        },
        "horizon_minutes": {
          "exclusiveMinimum": 0,
          "maximum": 375,
          "title": "Horizon Minutes",
          "type": "integer"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "informed_by_result_ids": {
          "items": {
            "type": "string"
          },
          "title": "Informed By Result Ids",
          "type": "array"
        },
        "mechanism": {
          "minLength": 12,
          "title": "Mechanism",
          "type": "string"
        },
        "minimum_data": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Minimum Data",
          "type": "array"
        },
        "observable_inputs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Observable Inputs",
          "type": "array"
        },
        "outcome": {
          "title": "Outcome",
          "type": "string"
        },
        "parameter_domain": {
          "additionalProperties": {
            "items": {},
            "type": "array"
          },
          "title": "Parameter Domain",
          "type": "object"
        },
        "parent_ids": {
          "items": {
            "type": "string"
          },
          "title": "Parent Ids",
          "type": "array"
        },
        "practical_effect": {
          "minimum": 0,
          "title": "Practical Effect",
          "type": "number"
        },
        "primary_comparison": {
          "minLength": 8,
          "title": "Primary Comparison",
          "type": "string"
        },
        "primary_metric": {
          "title": "Primary Metric",
          "type": "string"
        },
        "proposed_dsl": {
          "additionalProperties": true,
          "title": "Proposed Dsl",
          "type": "object"
        },
        "risk_constraints": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Risk Constraints",
          "type": "array"
        },
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "search_budget": {
          "default": 1,
          "maximum": 60,
          "minimum": 1,
          "title": "Search Budget",
          "type": "integer"
        },
        "source_refs": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Source Refs",
          "type": "array"
        },
        "version": {
          "default": 1,
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "campaign_id",
        "family_id",
        "mechanism",
        "expected_direction",
        "decision_change",
        "observable_inputs",
        "horizon_minutes",
        "outcome",
        "baseline_id",
        "primary_comparison",
        "primary_metric",
        "practical_effect",
        "risk_constraints",
        "minimum_data",
        "falsification_rule",
        "alternative_explanations"
      ],
      "title": "HypothesisSpec",
      "type": "object"
    },
    "InferencePlan": {
      "additionalProperties": false,
      "properties": {
        "alpha": {
          "default": 0.05,
          "exclusiveMaximum": 1,
          "exclusiveMinimum": 0,
          "title": "Alpha",
          "type": "number"
        },
        "block_length": {
          "default": 5,
          "minimum": 1,
          "title": "Block Length",
          "type": "integer"
        },
        "bootstrap_samples": {
          "default": 999,
          "minimum": 99,
          "title": "Bootstrap Samples",
          "type": "integer"
        },
        "confirmation_family": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confirmation Family"
        },
        "minimum_sessions": {
          "default": 30,
          "minimum": 5,
          "title": "Minimum Sessions",
          "type": "integer"
        },
        "practical_effect": {
          "default": 0.01,
          "minimum": 0,
          "title": "Practical Effect",
          "type": "number"
        },
        "robustness_block_lengths": {
          "items": {
            "type": "integer"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Robustness Block Lengths",
          "type": "array"
        },
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "unit": {
          "const": "session",
          "default": "session",
          "title": "Unit",
          "type": "string"
        }
      },
      "title": "InferencePlan",
      "type": "object"
    },
    "Relation": {
      "enum": [
        "NEW",
        "VARIANT",
        "REPAIR",
        "RERUN",
        "MONTE_CARLO",
        "REPLICATION",
        "RESULT_INFORMED",
        "DUPLICATE"
