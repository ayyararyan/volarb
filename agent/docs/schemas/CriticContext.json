        "qualification_id",
        "qualification_hash",
        "source_ids",
        "fidelity",
        "provenance",
        "verified_capabilities",
        "qualification_status",
        "coverage",
        "timing_semantics",
        "availability_semantics",
        "missingness_summary",
        "prior_exposed",
        "partition",
        "limitations"
