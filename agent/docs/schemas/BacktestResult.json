{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "media_type": {
          "default": "application/json",
          "title": "Media Type",
          "type": "string"
        },
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Size Bytes"
        },
        "uri": {
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "uri",
        "sha256"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "Fidelity": {
      "enum": [
        "F0",
        "F1",
        "F2",
        "F3",
        "F4"
      ],
      "title": "Fidelity",
      "type": "string"
    },
    "MetricEstimate": {
      "additionalProperties": false,
      "properties": {
        "lower": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lower"
        },
        "n_sessions": {
          "minimum": 0,
          "title": "N Sessions",
          "type": "integer"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "upper": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Upper"
        },
        "value": {
          "$ref": "#/$defs/Quantity"
        }
      },
      "required": [
        "name",
        "value",
        "n_sessions"
      ],
      "title": "MetricEstimate",
      "type": "object"
    },
    "Quantity": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "unknown_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unknown Reason"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "title": "Quantity",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "accounting_residuals": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Accounting Residuals",
      "type": "object"
    },
    "exclusions_and_missingness_ref": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "fidelity": {
      "$ref": "#/$defs/Fidelity"
    },
    "inventory_cash_paths_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "metrics": {
      "items": {
        "$ref": "#/$defs/MetricEstimate"
      },
      "title": "Metrics",
      "type": "array"
    },
    "opportunity_ledger_ref": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "order_fill_ledger_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "predictions_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "provenance": {
      "enum": [
        "SYNTHETIC",
        "HISTORICAL",
        "MODEL",
        "REPLAY"
      ],
      "title": "Provenance",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "session_outcomes_ref": {
      "$ref": "#/$defs/ArtifactRef"
    }
  },
  "required": [
    "run_id",
    "fidelity",
    "provenance",
    "opportunity_ledger_ref",
    "session_outcomes_ref",
    "exclusions_and_missingness_ref",
    "metrics"
  ],
  "title": "BacktestResult",
  "type": "object"
}
