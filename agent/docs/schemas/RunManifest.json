{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "media_type": {
          "default": "application/json",
          "title": "Media Type",
          "type": "string"
        },
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Size Bytes"
        },
        "uri": {
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "uri",
        "sha256"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "JobState": {
      "enum": [
        "QUEUED",
        "RUNNING",
        "COMPLETED",
        "INGESTED",
        "FAILED",
        "CANCEL_REQUESTED",
        "CANCELLED",
        "LOST_UNRESOLVED"
      ],
      "title": "JobState",
      "type": "string"
    },
    "Quantity": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "unknown_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unknown Reason"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "title": "Quantity",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "agent_models": {
      "items": {
        "type": "string"
      },
      "title": "Agent Models",
      "type": "array"
    },
    "artifact_refs": {
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "title": "Artifact Refs",
      "type": "array"
    },
    "attempt_id": {
      "title": "Attempt Id",
      "type": "string"
    },
    "code_commit": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Code Commit"
    },
    "code_commit_unknown_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Code Commit Unknown Reason"
    },
    "config_ref": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "environment_hash": {
      "title": "Environment Hash",
      "type": "string"
    },
    "evaluator_version": {
      "default": "1",
      "title": "Evaluator Version",
      "type": "string"
    },
    "experiment_id": {
      "title": "Experiment Id",
      "type": "string"
    },
    "failure_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "fencing_token": {
      "minimum": 0,
      "title": "Fencing Token",
      "type": "integer"
    },
    "finished_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finished At"
    },
    "graph_version": {
      "default": "1",
      "title": "Graph Version",
      "type": "string"
    },
    "model_prompt_refs": {
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "title": "Model Prompt Refs",
      "type": "array"
    },
    "resource_usage": {
      "additionalProperties": {
        "$ref": "#/$defs/Quantity"
      },
      "title": "Resource Usage",
      "type": "object"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "seed": {
      "title": "Seed",
      "type": "integer"
    },
    "source_tree_hash": {
      "title": "Source Tree Hash",
      "type": "string"
    },
    "started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Started At"
    },
    "status": {
      "$ref": "#/$defs/JobState"
    },
    "worker_identity": {
      "title": "Worker Identity",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "experiment_id",
    "attempt_id",
    "code_commit",
    "source_tree_hash",
    "environment_hash",
    "config_ref",
    "seed",
    "worker_identity",
    "fencing_token",
    "status"
  ],
  "title": "RunManifest",
  "type": "object"
}
