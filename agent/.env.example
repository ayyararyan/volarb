# ==============================
# Butterfly Research Laboratory
# ==============================
# Copy to agent/.env, then chmod 600 .env. This is the ONE user-editable
# machine/provider/runtime configuration file. Shell variables take precedence.
# Blank optional values use defaults. No variable/command interpolation occurs.
# Never put research definitions, raw data, or Codex OAuth tokens here.

# Private runtime state, outside git and cloud-synchronised directories.
# Blank uses ~/.local/share/butterfly-lab. Relative paths are relative to this file.
BUTTERFLY_LAB_HOME=

# Recommended real-model provider: codex. Others: fixture, replay, openai.
# Offline demos explicitly use fixture, regardless of the configured provider.
BUTTERFLY_LLM_PROVIDER=codex

# Codex owns ChatGPT sign-in and its credential storage. Run `codex` to sign in.
# Managed uses the supported local stdio app-server protocol (not host/port).
BUTTERFLY_CODEX_MODE=managed
BUTTERFLY_CODEX_COMMAND=codex
# Blank lets Codex resolve its default model; resolved model is recorded.
BUTTERFLY_CODEX_MODEL=
BUTTERFLY_CODEX_STARTUP_TIMEOUT_SECONDS=30
BUTTERFLY_CODEX_REQUEST_TIMEOUT_SECONDS=120

# Local ceilings; immutable campaign approvals may impose tighter limits.
# ChatGPT-plan usage is NOT represented as a fabricated API-dollar price.
BUTTERFLY_LLM_MAX_CONCURRENT_CALLS=2
BUTTERFLY_LLM_MAX_CALLS_PER_CAMPAIGN=40
BUTTERFLY_LLM_MAX_OUTPUT_TOKENS=4096
BUTTERFLY_LLM_MAX_INPUT_BYTES=65536
BUTTERFLY_NUMERICAL_WORKERS=2
BUTTERFLY_PENDING_JOB_LIMIT=20
BUTTERFLY_LOG_LEVEL=INFO

# Optional recorded-response provider: file of evidence, not secrets/config.
BUTTERFLY_REPLAY_PATH=

# Optional explicit API-key fallback only; never used by the Codex provider.
# To select openai, supply all of these except the standard endpoint default.
# No fallback happens automatically. Zero dollar budget disables API spending.
OPENAI_API_KEY=
BUTTERFLY_OPENAI_MODEL=
BUTTERFLY_OPENAI_BASE_URL=https://api.openai.com/v1
BUTTERFLY_OPENAI_MAX_COST_USD=0
BUTTERFLY_OPENAI_INPUT_USD_PER_MILLION=0
BUTTERFLY_OPENAI_OUTPUT_USD_PER_MILLION=0

# Scientific campaign/experiment/dataset specifications remain versioned JSON.
# Generated registry, checkpoints, signing keys, and provider accounting stay
# application-managed under BUTTERFLY_LAB_HOME; do not copy them into this file.
