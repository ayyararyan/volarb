# Install privately under the configured data directory (dhan/.env). Never commit .env.
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
MCP_HOST=127.0.0.1
MCP_PORT=3000
MCP_ALLOWED_HOSTS=
VOLARB_OBSERVE_ENABLED=false
DHAN_EXECUTION_ENABLED=false
DHAN_EXECUTION_STATIC_IP_CONFIRMED=false
DHAN_EXECUTION_EGRESS_IP=
MCP_PUBLIC_ORIGIN=
MCP_OAUTH_REDIRECT_URIS=

# Browser recovery is optional and currently macOS-only.
DHAN_BROWSER_RECOVERY_ENABLED=false
DHAN_PIN_FILE=
DHAN_BROWSER_EXECUTABLE=
DHAN_BROWSER_PORT=18802
