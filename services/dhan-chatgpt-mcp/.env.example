# Install privately under the configured data directory (dhan/.env). Never commit .env.
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# Canonical strategy-agnostic Dhan provider configuration.
DHAN_PROVIDER_COMMANDS_ENABLED=false
DHAN_PROVIDER_EGRESS_IP=
DHAN_PROVIDER_STATIC_IP_CONFIRMED=false
DHAN_PROVIDER_READINESS_TTL_MS=30000
DHAN_PROVIDER_EGRESS_CHECK_TIMEOUT_MS=5000
DHAN_API_TIMEOUT_MS=15000
DHAN_API_BASE_URL=https://api.dhan.co/v2
DHAN_INSTRUMENT_MASTER_URL=
DHAN_INSTRUMENT_MASTER_TTL_MS=21600000

# MCP/research service configuration.
MCP_HOST=127.0.0.1
MCP_PORT=3000
MCP_ALLOWED_HOSTS=
VOLARB_OBSERVE_ENABLED=false
MCP_PUBLIC_ORIGIN=
MCP_OAUTH_REDIRECT_URIS=

# Legacy butterfly executor compatibility. New Broker Port callers use
# DHAN_PROVIDER_* above. These remain during migration only.
DHAN_EXECUTION_ENABLED=false
DHAN_EXECUTION_STATIC_IP_CONFIRMED=false
DHAN_EXECUTION_EGRESS_IP=

# Browser recovery is optional and currently macOS-only.
DHAN_BROWSER_RECOVERY_ENABLED=false
DHAN_PIN_FILE=
DHAN_BROWSER_EXECUTABLE=
DHAN_BROWSER_PORT=18802
